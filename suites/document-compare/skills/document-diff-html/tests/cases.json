{
  "schemaVersion": "1.0",
  "kind": "synthetic-behavior-scenarios",
  "cases": [
    {
      "name": "双侧同步定位",
      "prompt": "打开三栏比对，点击一条右侧新增、一条修改和一条删除。",
      "expected": [
        "原件与比对件同时跳转",
        "空侧占位不伪造layoutId",
        "绿新增黄修改红删除",
        "对应块虚线连接"
      ]
    },
    {
      "name": "不执行材料标签",
      "prompt": "原文含脚本和HTML表格。",
      "expected": [
        "表格按文档格式显示",
        "脚本和事件属性不执行",
        "原始解析文本可回溯"
      ]
    }
  ]
}